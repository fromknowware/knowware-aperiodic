# Secret key for signing tokens — change this in production
PAYLOAD_SECRET=knowware-aperiodic-secret-change-me

# SQLite database file path
DATABASE_URI=file:./data.db

# The URL this CMS is served from (no trailing slash)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# URL of the Vite frontend (for CORS allowlist)
FRONTEND_URL=http://localhost:3000
